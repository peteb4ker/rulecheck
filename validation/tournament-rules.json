    "findings": [
      {
        "class": "DRIFT",
        "note": "Source: 'Any participant discovered to be in breach of the above should be removed from the tournament site.' The entry states 'Anyone caught doing one of these gets removed from the tournament site', turning a directive to staff into an automatic outcome and removing the staff discretion section 3.1 explicitly grants ('It is the responsibility of the Tournament Organizer and tournament staff to determine whether a participant should be permitted to remain').",
        "severity": "low"
      }
    ],
    "verdict": "findings"
  },
