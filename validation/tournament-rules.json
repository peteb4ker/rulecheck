    "entry_sha256": "7c148ef42349f578c9613f4b977ad55de17a68e364a7e4013d9dce4d305c1446",
    "findings": [
      {
        "class": "DRIFT",
        "note": "The entry adds a game-scope qualifier the section does not carry: 'Round-robin play is available for Pokemon GO tournaments at the level of Regional Championships and above.' Section 5.5.5.3's own text says only 'at the discretion of the Organizer ... for events at the level of Regional Championships and above'; only the parent heading (5.5.5 Double Elimination) is Pokemon GO specific, and unlike 5.5.5.1 and 5.5.5.2 this section names no game. A TCG or VG Regional Organizer with a division of six or fewer would read round-robin as unavailable to them.",
        "severity": "low"
      }
    ],
    "verdict": "findings"
  },
