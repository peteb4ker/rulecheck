    "findings": [
      {
        "class": "INVENTION",
        "note": "The entry's note asserts the Pokemon GO self-check 'takes the place of the usual pre-round window'. The source says only that Pokemon GO competitors are responsible for checking their bracket before the next round because Pokemon GO does not use TOM at Regional level and above; it never says the reasonable-time window for reporting errors does not apply to them.",
        "severity": "low"
      }
    ],
