  "tcg-Turn Actions": {
    "entry_sha256": "07f033a388886563e21bc0b9ce2070069e671340cfc6961551ea2eb1fa03ea3e",
    "findings": [
      {
        "class": "OMISSION",
        "note": "the source states that an evolved Pokemon cannot use the attacks or Abilities of the stage beneath it unless a card says otherwise; nothing in the whole authored corpus carried that rule, while the BREAK Evolution entry asserts the opposite behaviour as if it were unremarkable — a player would keep using the pre-evolution's attacks. Fixed: the evolve step now says the evolved Pokemon can no longer reach down for what was printed underneath",
        "resolved": true,
        "severity": "high"
      },
      {
        "class": "OMISSION",
        "note": "the source tells players to announce which Abilities they are using so the opponent can follow along; the entry keeps the Ability step but not that procedural obligation",
        "resolved": false,
        "severity": "low"
      }
    ],
    "verdict": "findings"
  },
